# ================================
# TDO - Git Ignore
# ================================

# ---------- Environment / Secrets ----------
.env
.env.*
!.env.example

# ---------- Python ----------
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/

# Python testing / tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- Local PostgreSQL ----------
.pgdata/

# ---------- Node ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Frontend Build ----------
dist/
build/
.vite/

# ---------- TypeScript ----------
*.tsbuildinfo

# ---------- IDE ----------
.vscode/
.idea/
*.swp
*.swo

# Keep VS Code project settings only if intentionally added
# !.vscode/extensions.json

# ---------- OS ----------
.DS_Store
Thumbs.db

# ---------- Logs ----------
*.log

# ---------- Temporary files ----------
*.tmp
*.temp
*.bak

# ---------- Coverage ----------
coverage/
.nyc_output/

# ---------- Local database / development files ----------
*.sqlite
*.sqlite3
*.db

docs/
